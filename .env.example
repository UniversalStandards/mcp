# Server Configuration
PORT=3000
NODE_ENV=production
HOST=127.0.0.1
BODY_LIMIT=1mb

# GitHub Integration
GITHUB_TOKEN=
GITHUB_OWNER=UniversalStandards
GITHUB_REPO=mcp
GITHUB_BRANCH=main

# Registry Sources
GITHUB_REGISTRY_URL=https://github.com/mcp
OFFICIAL_REGISTRY_URL=https://registry.modelcontextprotocol.io

# AI Normalizer (OpenAI/Anthropic/etc.)
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-4o

# Security
JWT_SECRET=
ENCRYPTION_KEY=
API_KEY_PEPPER=

# Capability installation is disabled by default.
MCP_AUTO_INSTALL=false
MCP_INSTALL_TIMEOUT_MS=300000
MCP_APPROVED_PACKAGES=
# Comma-separated HTTP authorities (include the external port when non-default).
# Empty host configuration permits only loopback hosts.
MCP_ALLOWED_HOSTS=
# Browser requests carrying Origin are denied unless explicitly listed here.
MCP_ALLOWED_ORIGINS=

# Projects & Apps
GITHUB_PROJECT_ID=
DEFAULT_PROJECT_ID=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# OAuth (optional)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Brave Search (optional)
BRAVE_API_KEY=

# Database (optional)
DB_CONNECTION_STRING=

# Webhooks
WEBHOOK_ENDPOINT=
WEBHOOK_SECRET=

# Workspace
WORKSPACE_PATH=.
GITHUB_REPOS_PATH=./servers
